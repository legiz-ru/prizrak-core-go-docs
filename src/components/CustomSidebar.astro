---
// Sidebar as the app's nav pills (src/components/menu/MyNav.vue): a Tabler
// icon per top-level page, the current page filled with the accent. Groups
// fold with <details>; SidebarPersister/SidebarRestorePoint keep Starlight's
// remembered open state and scroll position.
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import TablerIcon from './TablerIcon.astro';
import SidebarSub from './SidebarSub.astro';
import type { IconName } from './icons';

type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];

const { sidebar, locale } = Astro.locals.starlightRoute;

/** Icons by link path (locale prefix stripped) or by full URL for external links. */
const iconByPath: Record<string, IconName> = {
	'/': 'home',
	'/startup/': 'download',
	'/handbook/': 'book',
	'/config/': 'settings',
	'/remnawave/': 'plug-connected',
	'/api/': 'api',
	'/example/': 'terminal-2',
};

const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, '');
const localePrefix = basePrefix + (locale ? '/' + locale : '');

/** Path without the site base and the locale, e.g. /config/. */
function stripLocale(href: string): string {
	return href.startsWith(localePrefix + '/') ? href.slice(localePrefix.length) : href;
}

/** A group takes the icon of its first page when that page has one. */
function iconFor(entry: Entry): IconName {
	if (entry.type === 'group') {
		const first = entry.entries.find((e) => e.type === 'link');
		return (first && first.type === 'link' && iconByPath[stripLocale(first.href)]) || 'code';
	}
	return iconByPath[stripLocale(entry.href)] ?? (/^https?:/.test(entry.href) ? 'external-link' : 'file-text');
}

/** Link attributes without `class`, which goes through class:list instead. */
function linkAttrs(entry: Entry) {
	if (entry.type !== 'link') return {};
	const { class: _class, ...rest } = entry.attrs;
	return rest;
}

const hasCurrent = (entries: Entry[]): boolean =>
	entries.some((e) => (e.type === 'link' ? e.isCurrent : hasCurrent(e.entries)));
---

<SidebarPersister>
	<ul class="px-nav">
		{
			sidebar.map((entry) => (
				<li>
					{entry.type === 'link' ? (
						<a
							href={entry.href}
							aria-current={entry.isCurrent ? 'page' : undefined}
							class:list={['px-nav__item', entry.attrs.class]}
							{...linkAttrs(entry)}
						>
							<TablerIcon name={iconFor(entry)} />
							<span class="px-nav__label">{entry.label}</span>
						</a>
					) : (
						<details open={hasCurrent(entry.entries) || !entry.collapsed}>
							<summary class="px-nav__item">
								<TablerIcon name={iconFor(entry)} />
								<span class="px-nav__label">{entry.label}</span>
								<TablerIcon name="chevron-right" size={16} class="px-nav__caret" />
							</summary>
							<SidebarRestorePoint />
							<SidebarSub entries={entry.entries} />
						</details>
					)}
				</li>
			))
		}
	</ul>
</SidebarPersister>

<style>
	.px-nav {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.px-nav__item {
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
		padding: 10px 12px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.25;
		color: var(--text);
		text-decoration: none;
		background: var(--side-bg);
		cursor: pointer;
		transition: background 0.15s;
		user-select: none;
	}

	.px-nav__item:hover {
		background: var(--hover-bg);
	}

	.px-nav__item[aria-current='page'],
	.px-nav__item[aria-current='page']:hover {
		background: var(--accent);
		color: var(--on-accent);
	}

	.px-nav__label {
		flex: 1;
		min-width: 0;
		overflow-wrap: break-word;
	}

	summary.px-nav__item {
		list-style: none;
	}

	summary.px-nav__item::-webkit-details-marker,
	summary.px-nav__item::marker {
		display: none;
	}

	.px-nav__caret {
		color: var(--text-2);
		transition: transform 0.2s;
	}

	details[open] > summary .px-nav__caret {
		transform: rotate(90deg);
	}




</style>
